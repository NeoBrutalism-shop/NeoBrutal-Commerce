    {"path":"/product/soft","id":"product-soft","intent":"product-detail","primaryComponents":["product-detail","product-gallery","license-selector","renewal-note"]},
    {"path":"/pricing","id":"pricing","intent":"plan-comparison","primaryComponents":["pricing-tier","plan-comparison","bundle-builder"]},
    {"path":"/cart","id":"cart","intent":"full-cart","primaryComponents":["cart-item","order-summary","coupon"]},
    {"path":"/checkout","id":"checkout","intent":"checkout","primaryComponents":["checkout-field","checkout-steps","payment-method","order-summary"]},
    {"path":"/order/success","id":"order-success","intent":"receipt-entitlement","primaryComponents":["order-confirmation","receipt","download-entitlement"]},
    {"path":"/account","id":"account","intent":"customer-ownership","primaryComponents":["account-nav","download-row","purchase-history-row","license-card"]},
    {"path":"/account/license/:id","id":"account-license","intent":"license-detail","example":"/account/license/demo-soft-team","primaryComponents":["license-card","license-status","activation-row","update-eligibility"]},
