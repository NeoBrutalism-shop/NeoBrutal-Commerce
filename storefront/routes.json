{
  "version": "1.0.0",
  "routes": [
    {
      "path": "/",
      "id": "home",
      "intent": "storefront-home",
      "primaryComponents": [
        "product-card",
        "trust-strip",
        "promo-band"
      ]
    },
    {
      "path": "/products",
      "id": "products",
      "intent": "product-catalog",
      "primaryComponents": [
        "product-card",
        "badge",
        "price-block"
      ]
    },
    {
      "path": "/product/soft",
      "id": "product-soft",
      "intent": "product-detail",
      "primaryComponents": [
        "product-detail",
        "product-gallery",
        "product-media",
        "review-summary",
        "testimonials",
        "guarantee",
        "license-selector",
        "renewal-note"
      ],
      "states": [
        "preview",
        "code",
        "files"
      ]
    },
    {
      "path": "/pricing",
      "id": "pricing",
      "intent": "plan-comparison",
      "primaryComponents": [
        "pricing-tier",
        "plan-comparison",
        "bundle-builder"
      ]
    },
    {
      "path": "/cart",
      "id": "cart",
      "intent": "full-cart",
      "primaryComponents": [
        "cart-item",
        "order-summary",
        "coupon"
      ]
    },
    {
      "path": "/checkout",
      "id": "checkout",
      "intent": "checkout",
      "primaryComponents": [
        "checkout-field",
        "invoice-details",
        "checkout-steps",
        "payment-method",
        "payment-failure",
        "payment-recovery",
        "processing-state",
        "order-summary"
      ],
      "states": [
        "ready",
        "processing",
        "failed",
        "recovered"
      ]
    },
    {
      "path": "/order/success",
      "id": "order-success",
      "intent": "receipt-entitlement",
      "primaryComponents": [
        "order-confirmation",
        "receipt",
        "download-entitlement"
      ]
    },
    {
      "path": "/account",
      "id": "account",
      "intent": "customer-ownership",
      "primaryComponents": [
        "account-nav",
        "download-row",
        "purchase-history-row",
        "license-card",
        "invoice-history"
      ]
    },
    {
      "path": "/account/license/:id",
      "id": "account-license",
      "intent": "license-lifecycle",
      "example": "/account/license/demo-soft-team",
      "primaryComponents": [
        "license-card",
        "license-status",
        "activation-row",
        "update-eligibility",
        "seat-assignment",
        "renewal-state",
        "plan-change",
        "ownership-transfer",
        "subscription-management",
        "ownership-timeline"
      ],
      "states": [
        "active",
        "grace",
        "expired",
        "cancelled",
        "refunded",
        "ready",
        "quoted",
        "processing",
        "complete",
        "failed",
        "cancel_at_period_end",
        "past_due"
      ]
    },
    {
      "path": "/components",
      "id": "components",
      "intent": "system-showcase",
      "primaryComponents": [
        "component-contract",
        "tokens",
        "system-states",
        "ownership-lifecycle",
        "review-summary",
        "guarantee"
      ]
    }
  ]
}
